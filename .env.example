# ---------------------------------------------------------------------------
# Copy to .env.local for local runs. On Vercel, set these in
# Project -> Settings -> Environment Variables. Never commit real values.
# ---------------------------------------------------------------------------

# Session cookie signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Employee directory (Turso / libSQL).
# Production: libsql://<db>-<org>.turso.io
# Local dev:  file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# zRetailHQ0 (Microsoft SQL Server).
# Real host, port, user and password live in .env.local and in the Vercel
# environment - never here. This file is committed.
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DATABASE=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# Optional: comma-separated emails treated as portal admins
PORTAL_ADMIN_EMAILS=

# Session lifetime in hours (default 8)
SESSION_HOURS=8

# --- Reading the business's employee table ---------------------------------
# The app owns portal_users and login_audit. The HR employees table is read
# only. These override the column detection when the guesses are wrong.
HR_TABLE=employees
HR_COL_EMAIL=
HR_COL_NAME=
HR_COL_DESIGNATION=
HR_COL_CODE=
HR_COL_DEPARTMENT=
HR_COL_ACTIVE=

# --- One-time setup from inside the deployment -----------------------------
# Enables POST /api/admin/bootstrap and GET /api/admin/inspect. Remove once
# the directory is seeded; both then return 404.
BOOTSTRAP_TOKEN=
