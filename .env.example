# ---------------------------------------------------------------------------
# Copy to .env.local for local runs. On Vercel, set these in
# Project -> Settings -> Environment Variables. Never commit real values.
# ---------------------------------------------------------------------------

# Session cookie signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Employee directory (Turso / libSQL).
# Production: libsql://<db>-<org>.turso.io
# Local dev:  file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# zRetailHQ0 (Microsoft SQL Server).
# Real host, port, user and password live in .env.local and in the Vercel
# environment - never here. This file is committed.
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DATABASE=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# Optional: comma-separated emails treated as portal admins
PORTAL_ADMIN_EMAILS=

# Session lifetime in hours (default 8)
SESSION_HOURS=8

# --- Reading the business's employee table ---------------------------------
# The app owns portal_users and login_audit. The HR employees table is read
# only. These override the column detection when the guesses are wrong.
HR_TABLE=employees
HR_COL_EMAIL=
HR_COL_NAME=
HR_COL_DESIGNATION=
HR_COL_CODE=
HR_COL_DEPARTMENT=
HR_COL_ACTIVE=

# Who in that table gets a portal sign-in. The directory covers the whole
# chain; this app shows supplier rankings, the buying book and what the
# company owes. Pick one:
#   HR_INCLUDE_ROLES=owner,buyer,accounts   match the table's own role column
#   HR_INCLUDE_DESIGNATIONS=buyer,buying    match designation text
#   HR_INCLUDE_ALL=1                        everyone with a valid email
# With none set, the buying-side designation default applies.
HR_INCLUDE_ROLES=
HR_INCLUDE_DESIGNATIONS=
HR_INCLUDE_ALL=

# --- One-time setup from inside the deployment -----------------------------
# Enables POST /api/admin/bootstrap and GET /api/admin/inspect. Remove once
# the directory is seeded; both then return 404.
BOOTSTRAP_TOKEN=

# --- Where the portal's figures come from ----------------------------------
# demo (default) shows a warning strip on every screen, because the numbers
# are the sample data built into the SPA. Set to live only once the screens
# actually read zRetailHQ0.
DATA_SOURCE=demo
DATA_SOURCE_NOTE=

# Reporting views in zRetailHQ0 (override only if renamed).
SQL_VIEW_PURCHASES=VW_MB_POWERBI_PUR_REPORT
SQL_VIEW_PURCHASE_RETURNS=VW_MB_POWERBI_PRT_REPORT
SQL_VIEW_SALES=VW_MB_POWERBI_SLS_DATA_WITHOUT_ITEMID
SQL_VIEW_INVENTORY=VW_MB_AI_DSB_REPORT

# Fabric breakdowns are off: FabricShortName was specified but the server
# rejects it as an invalid column name. Set this to the real column name to
# turn every fabric breakdown back on - nothing else needs changing.
SQL_COL_FABRIC=

# --- Capturing input into a Google Sheet -----------------------------------
# The sheet is a mirror, never the record: orders and captures are written to
# Turso first and mirrored afterwards, so an unreachable spreadsheet cannot
# lose an order. With none of this set, capture still works and the sheet is
# skipped.
#
# Either a service account (share the sheet with its address as an Editor):
SHEET_ID=1NR2D1Lgemn-coqBXaPG1hVNBhiDBhMXT2Ap4Q_8HnTg
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
#
# ...or an Apps Script web app, where the URL is the credential:
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
#
# Tab names. Both must already exist - nothing here creates or reshapes tabs.
SHEETS_ORDER_TAB=Purchase Orders
SHEETS_CAPTURE_TAB=Captures
