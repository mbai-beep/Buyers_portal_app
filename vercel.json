{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/portal.js": {
      "includeFiles": "assets/**",
      "maxDuration": 20,
      "memory": 1024
    },
    "api/admin.js": {
      "includeFiles": "assets/**",
      "maxDuration": 60,
      "memory": 1024
    },
    "api/reports.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/portal",
      "destination": "/api/portal"
    },
    {
      "source": "/api/reports/:report",
      "destination": "/api/reports?report=:report"
    },
    {
      "source": "/api/admin/:action",
      "destination": "/api/admin?action=:action"
    },
    {
      "source": "/api/health/:check",
      "destination": "/api/health?check=:check"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
